Algoritmo CelsiusToFahrenheit
	// Declaration variable
	Definir celsius, fahrenheit Como Real
	
	// Get data from user
	Escribir "TEMPERATURE CONVERTER "
	Escribir "Enter temperature in Celsius:"
	Leer celsius
	
	// Operations
	// Formula: (Celsius * 9/5) + 32
	fahrenheit <- (celsius * 1.8) + 32
	
	// Output results
	Escribir "Temperature in Fahrenheit is: ", fahrenheit
FinAlgoritmo