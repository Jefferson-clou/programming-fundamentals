Algoritmo AvarageSpeed
	//Get data
	//Identiffy the avarage speed
	Definir distance, time, speed Como Real
	//Request the data from the user
	Escribir "Enter the distance traveled: "
	Leer distance
	Escribir "Enter the time taken: "
	Leer time
	//Calulation 
	//Formula: speed = distance / time
	speed <- distance / time
	//Output:Result
	Escribir "Avarage speed is: " speed
FinAlgoritmo
