Algoritmo CurrencyConversion
	//Declaration variables
	Definir pesos, conversion, dolares Como Real
	//Get data
	Escribir "Enter amount in Colombian pesos: "
	Leer pesos
	Escribir "Enter amount in converion: "
	Leer conversion
	//Operation
	dolares <- pesos / conversion
	//Output:Result
	Escribir "The amount in dolares is: ", dolares
FinAlgoritmo
