Algoritmo Meters
	//Get data
	//Identify the distance
	//Declaration variable
	Definir kilometros, totalmetros Como Real
	//Identify the distance in kilometros
	Escribir "Enter the distance in kilometros: "
	Leer kilometros
	//Operation (1 km = 1000 m)
	totalmetros <- kilometros * 1000
	//Output:Result
	Escribir "The distance in meters is: ", totalmetros 
FinAlgoritmo
