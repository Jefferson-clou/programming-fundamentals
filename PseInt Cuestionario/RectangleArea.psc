Algoritmo RectangleArea
	//Declaration variable
	Definir base, height, area Como Real
	//Request the data from the user
	Escribir "Enter the base of the rectangle: "
	Leer base
	Escribir "Enter the height of the rectangle: "
	Leer height
	//Calculate area:
	area <- base * height
	//Output:Result
	Escribir "The area es: ", area
FinAlgoritmo
