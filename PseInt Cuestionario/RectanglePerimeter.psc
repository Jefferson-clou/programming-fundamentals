Algoritmo RectanglePerimeter
	//Declaration variable
	Definir base, height, perimeter Como Real
	//Request the data from the user
	Escribir "Enter the base of the rectangle: "
	Leer base
	Escribir "Enter the height of the rectangle: "
	Leer height
	Escribir "Enter the perimeter of the rectangle: "
	Leer perimeter
	//Calculate perimeter:
	perimeter <- 2 * (base + height)
	//Output:Result
	Escribir "The perimeter es: ", perimeter
FinAlgoritmo
