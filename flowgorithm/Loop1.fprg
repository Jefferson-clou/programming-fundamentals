<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Loop1"/>
        <attribute name="authors" value="sarit"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-26 03:46:17 p.&#8239;m."/>
        <attribute name="created" value="c2FyaXQ7SkVGRkVSU09OOzIwMjYtMTAtMjY7MDI6MzU6MDcgcC7igK9tLjsxMDg5Ng=="/>
        <attribute name="edited" value="c2FyaXQ7SkVGRkVSU09OOzIwMjYtMTAtMjY7MDM6NDY6MTcgcC7igK9tLjszOzExMDEw"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, die1, die2, par, impar, igual" type="Integer" array="False" size=""/>
            <assign variable="par" expression="0"/>
            <assign variable="impar" expression="0"/>
            <assign variable="igual" expression="0"/>
            <declare name="key" type="String" array="False" size=""/>
            <for variable="i" start="1" end="10" direction="inc" step="1">
                <output expression="&quot;Pres any key to roll dice: &quot;" newline="True"/>
                <input variable="Key"/>
                <output expression="&quot;Roll # &quot; &amp; i" newline="True"/>
                <assign variable="die1" expression="Random(6) + 1"/>
                <assign variable="die2" expression="Random(6) + 1"/>
                <output expression="&quot;Die1 : &quot; &amp; die1" newline="True"/>
                <output expression="&quot;Die2 : &quot; &amp; die2" newline="True"/>
                <declare name="add" type="Integer" array="False" size=""/>
                <assign variable="add" expression="die1 + die2"/>
                <if expression="add mod 2 = 0">
                    <then>
                        <output expression="&quot;The add of the two dies is : &quot; &amp; add" newline="True"/>
                        <assign variable="par" expression="par+1"/>
                    </then>
                    <else>
                        <if expression="add %2 != 0">
                            <then>
                                <output expression="&quot;The sum of the two dice is odd : &quot;" newline="True"/>
                                <assign variable="impar" expression="impar+1"/>
                            </then>
                            <else>
                                <if expression="Die1 = Die2">
                                    <then>
                                        <output expression="&quot;The dice are the same : &quot;" newline="True"/>
                                        <assign variable="igual" expression="igual+1"/>
                                    </then>
                                    <else/>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </for>
            <output expression="&quot;Par :&quot; &amp; par &amp; ToChar (13) &amp;&#13;&#10;&quot;Even :&quot; &amp; impar &amp; ToChar (13) &amp;&#13;&#10;&quot;Odd :&quot; &amp; igual &amp; ToChar (13)" newline="True"/>
        </body>
    </function>
</flowgorithm>
